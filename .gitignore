node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.local
.env.development
.env.production

# Logs
logs/
*.log
*.log.*
debug.log

# Dist / Build
dist/
build/

# Coverage
coverage/

# Cache
.cache/
.tmp/

# OS crap
.DS_Store
Thumbs.db

